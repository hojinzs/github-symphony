{
  "name": "@gh-symphony/fleet-control-plane",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Private fleet configuration, SQLite persistence and enrollment services",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/run-log-client.ts --bundle --platform=browser --format=iife --outfile=dist/browser/run-log-client.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@gh-symphony/management-protocol": "workspace:*",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.27.3"
  }
}
